{
  "name": "commit-horizon",
  "version": "0.2.1",
  "description": "Your GitHub year spiraling into a black hole (and your languages orbiting it) — animated SVGs for your profile README.",
  "type": "module",
  "bin": {
    "commit-horizon": "bin/commit-horizon.js"
  },
  "scripts": {
    "demo": "node scripts/demo.js",
    "preview": "node scripts/preview.js",
    "dev": "node tools/dev-server.mjs",
    "test": "node --test",
    "vendor-icons": "node scripts/vendor-icons.mjs",
    "demo:languages": "node bin/commit-horizon.js --demo --mode languages --out examples/commit-horizon-languages.svg",
    "record": "node tools/record.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "github",
    "readme",
    "profile",
    "svg",
    "contributions",
    "black-hole",
    "space"
  ],
  "license": "MIT",
  "optionalDependencies": {
    "devicon": "^2.16.0"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
